@page
@model DbscSample.Host.Pages.Login
@{
    ViewData["Title"] = "Login";
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">Demo: any username works if the password is the same as the username.</p>

<form method="post" class="col-md-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
    </div>

    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
